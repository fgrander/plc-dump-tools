    en-US: 'TANK: 2*9.81'
  - id: MLC_50
    en-US: 'HEAT: gain value'
  - id: MLC_51
    en-US: gravitational acceleration (a = 9,81 m/s²)
  - id: MLC_52
    en-US: 'TANK: Vin switch [l/min]'
  - id: MLC_53
    en-US: 'TANK: Vin recalculation (l/min => m³/s) [m³/s]'
  - id: MLC_54
    en-US: 'TANK: sqrt of tank level [m³]'
  - id: MLC_55
    en-US: 'TANK: calculate output gain (AB/AT *sqrt(2*9,81)) -> fix value'
  - id: MLC_56
    en-US: 'TANK: multiply output gain [m³]  -  fix value for option ''install filling pump'''
  - id: MLC_57
    en-US: 'TANK: Vout switch (input for bottle)'
  - id: MLC_58
    en-US: 'TANK: Vout multiplier [m³/s]'
