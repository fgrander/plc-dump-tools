MultiLingualTexts:
  - id: MLC_1
    en-US: input variable
  - id: MLC_2
    en-US: time lag 1 in s
  - id: MLC_3
    en-US: time lag 2 in s
  - id: MLC_4
    en-US: time lag 3 in s
  - id: MLC_5
    en-US: proportional gain
  - id: MLC_6
    en-US: disturbance variable (additional to "input")
  - id: MLC_7
    en-US: sample time [in sec]
  - id: MLC_8
    en-US: 'complete restart (#output = #input)'
  - id: MLC_9
    en-US: 'error (#tmLag1 <= 0 or #tmLag2 <= 0 or #tmLag3 <= 0)'
  - id: MLC_10
    en-US: 'status (if #error = TRUE then status = 16#8001)'
  - id: MLC_11
    en-US: 'output signal (if #error = FALSE)'
  - id: MLC_12
    en-US: feedback path value 1
  - id: MLC_13
    en-US: feedback path value 2
  - id: MLC_14
    en-US: feedback path value 3
  - id: MLC_15
    en-US: help variable
  - id: MLC_16
    en-US: cycle to real
  - id: MLC_17
    en-US: time lag 1 to real
  - id: MLC_18
    en-US: time lag 2 to real
  - id: MLC_19
    en-US: time lag 3 to real
  - id: MLC_20
    en-US: new output variable
