TYPE
    typeOperate : STRUCT
        { S7_MLC := "MLC_1" }
        extModeActive : Bool := false;
        {
            S7_MLC := "MLC_2";
            S7_Setpoint := "False"
        }
        state : _.typeState;
        {
            S7_MLC := "MLC_3";
            S7_Setpoint := "True"
        }
        machineState : Int := 0;
        { S7_MLC := "MLC_4" }
        machineStateOEE : Int := 0;
    END_STRUCT;
END_TYPE
