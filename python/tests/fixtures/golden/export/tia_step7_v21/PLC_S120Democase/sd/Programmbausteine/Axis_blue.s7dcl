    { S7_Language := "FBD" }
    NETWORK
        RUNG
            { S7_Templates := "[SrcType := Int, DestType := LReal]" }
            Normalize(
                min := 0,
                value := "TB30_AI_0",
                max := 16384,
                out => #velocity
            )
            { S7_Templates := "SrcType := LReal" }
            Mul(
                in1 := #velocity,
                in2 := 6000.0,
                out => #tempVelocity
            )
            { S7_Templates := "value_type := LReal" }
            Limit(
                min := 0.0,
                in := #tempVelocity,
                max := 6000.0,
                out => #velocity
            )
        END_RUNG
    END_NETWORK
    { S7_Language := "FBD" }
    NETWORK
