MultiLingualTexts:
  - id: MLC_4Jw
    en-US: recalculate with new parameters
  - id: MLC_37A
    en-US: input signal
  - id: MLC_4uC
    en-US: time constant T1 [sec]
  - id: MLC_4fC
    en-US: gain factor
  - id: MLC_4j3
    en-US: cyclic time [sec]
  - id: MLC_479
    en-US: max. output limit
  - id: MLC_44R
    en-US: min. output limit
