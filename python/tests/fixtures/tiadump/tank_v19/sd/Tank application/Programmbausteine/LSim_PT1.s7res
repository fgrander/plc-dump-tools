MultiLingualTexts:
  - id: MLC_dV
    en-US: recalculate with new parameters
  - id: MLC_3f6
    en-US: input signal
  - id: MLC_42C
    en-US: time constant T1 [sec]
  - id: MLC_59V
    en-US: gain factor
  - id: MLC_3Qb
    en-US: cyclic time [sec]
  - id: MLC_pG
    en-US: max. output limit
  - id: MLC_4na
    en-US: min. output limit
  - id: MLC_ae
    en-US: resets all relevant parameters to ‘0’ including the output
  - id: MLC_Tx
    en-US: 'error (#tmLag1 <= 0)'
  - id: MLC_3Rm
    en-US: 'status (if #tmLag1 <= 0 then status = 16#8001)'
  - id: MLC_ZW
    en-US: output has reached max. limit
  - id: MLC_4ep
    en-US: output has reached min. limit
  - id: MLC_ei
    en-US: 'output signal (if #error = FALSE)'
