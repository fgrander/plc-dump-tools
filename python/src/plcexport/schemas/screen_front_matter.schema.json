{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plcexport/screen_front_matter.schema.json",
  "title": "Front matter of hmi/screens/<name>.md (contract §7)",
  "type": "object",
  "required": [
    "name",
    "device",
    "objects"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "tag_bindings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
